/* ============================================================
   DISTA AI — RETRO-MODERN DARK STYLESHEET
   Glowing Orange Highlights (#FF6B00) · Deep Obsidian Navy (#0E0F14)
   ============================================================ */

QWidget {
    background-color: #0E0F14;
    color: #E2F0FD;
    font-family: 'Segoe UI', 'Roboto', 'Arial', sans-serif;
    font-size: 13px;
}

/* Main Window */
QMainWindow {
    background-color: #0E0F14;
}

/* Tool Shortcut Cards */
QFrame#tool_card {
    background-color: #161822;
    border: 1px solid #282B3D;
    border-radius: 12px;
    padding: 10px;
}
QFrame#tool_card:hover {
    border: 1px solid #FF6B00;
    background-color: #1E202E;
}

/* Glowing Orange Accent Buttons */
QPushButton {
    background-color: #1A1C28;
    color: #E2F0FD;
    border: 1px solid #32364A;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #FF6B00;
    color: #FFFFFF;
    border: 1px solid #FF8800;
}
QPushButton:pressed {
    background-color: #CC5500;
}

/* Special Primary Accent Buttons */
QPushButton#btn_primary {
    background-color: #FF6B00;
    color: #FFFFFF;
    border: 1px solid #FF8800;
    font-weight: 700;
}
QPushButton#btn_primary:hover {
    background-color: #FF8800;
    box-shadow: 0 0 15px rgba(255, 107, 0, 0.6);
}

/* Mic Active Button */
QPushButton#btn_mic[active="true"] {
    background-color: #00E5FF;
    color: #0E0F14;
    border: 1px solid #00E5FF;
}

/* Input Fields */
QLineEdit, QTextEdit {
    background-color: #141620;
    color: #F0F6FF;
    border: 1px solid #2A2D40;
    border-radius: 8px;
    padding: 10px;
    selection-background-color: #FF6B00;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #FF6B00;
    background-color: #1A1D2A;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid #282B3D;
    border-radius: 8px;
    background-color: #141620;
}
QTabBar::tab {
    background-color: #161822;
    color: #8C94A8;
    padding: 8px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #FF6B00;
    color: #FFFFFF;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #10121A;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #2A2D40;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #FF6B00;
}

/* Status Labels */
QLabel#status_label {
    color: #FF8800;
    font-size: 11px;
    letter-spacing: 1px;
    font-weight: bold;
}
